# Lets the app create Drives and Sandboxes in the linked Vercel project.
# `vercel env pull` writes it; it expires after about 12 hours.
VERCEL_OIDC_TOKEN=

# Passed to each chat's sandbox, where libfx calls AI Gateway with it.
AI_GATEWAY_API_KEY=

# Optional: the model every chat runs. Default anthropic/claude-haiku-5.5.
# FX_MODEL=

# Signs the image URLs a design's preview loads (at least 32 characters).
# openssl rand -base64 48
SESSION_SECRET=
